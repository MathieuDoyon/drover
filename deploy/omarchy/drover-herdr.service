[Unit]
Description=herdr-app with the Drover mods (permanent Drover on omarchy)
After=default.target
# Never give up restarting (only valid in [Unit]).
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HERDR_APP_HOME=%h/.config/herdr-app
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional: HC_SESSION=<name> (isolated core). The leading '-' makes the file optional.
EnvironmentFile=-%h/.config/herdr-app/service.env
# No desktop: the app must not pick up a compositor from the login session.
UnsetEnvironment=WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE
ExecStart=%h/.local/bin/herdr-app
# Mods only run when the drover layout is active: switch it once the app answers (idempotent).
# A failure here is ignored ('-'); the app keeps running and the runbook shows how to switch by hand.
ExecStartPost=-/bin/sh -c 'i=0; while [ "$$i" -lt 30 ]; do herdr-app do layout.switch "{\\"name\\":\\"drover\\"}" >/dev/null 2>&1 && exit 0; i=$$((i+1)); sleep 2; done; exit 1'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
