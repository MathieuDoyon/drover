#!/usr/bin/env bash
# Drover CLI for agents. Writes go through an open Drover mod (file inbox); reads come from shared.json.
set -euo pipefail
home="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
# This script's physical folder, resolved ONCE before anything else: every helper is found next to the real file, so one run uses one generation end to end.
# Follows the symlink chain (readlink without -f: it is not portable to macOS).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  ldir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$ldir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
usage() {
  cat >&2 <<'EOF'
usage: drover tasks [tag|column] [--project <id|name>]   list tasks (id, column, priority, tags, title)
       drover task <T-…>                          one task with its description
       drover note <T-…> [--kind decision|log|blocker|pr|handoff|review] "<text…>"   add a note to a task (after an owner decision or a scope)
                                                  a review note is one line: head=<sha> verdict=pass|adverse report=<abs path> (full 40-hex commit; quote a path with spaces)
       drover line <T-…> "<text, 40 characters at most>" [--progress 0-100]   say what your run is doing now (shows on the run card and the Tasks row; gone when the run ends).
                                                  Post one at each STATUS. Never put a value (token, key, password) or a home path in it
       drover edit <T-…> [--title "<t>"] [--desc "<d>"] [--parent <T-…|none>]   replace the title, the description and/or the parent (1 flag at least)
       drover projects                            list projects (id, name, default repo)
       drover project add "<name>" --repo <abs path> [--branch <b>] [--folder <abs path>]…   create a project (repo = default; branch defaults to the repo's current one)
       drover task-project <T-…> <id|name|none>   put a task in a project (none clears it)
       drover link <T-…> <url|none>               link a card to its GitHub issue/PR or Jira issue (shows as Source in the task dialog); none unlinks
       drover squads                              list squads and agents you can start
       drover agents export [--out <file>] [--agent <id>]… [--squad <id>]…   export agents and squads as JSON (stdout, or a new private file; node reads shared.json, else an open mod answers); never exports env values; a secret blocks it
       drover agents import <file> [--confirm <token>]   dry run by default (prints the plan and a token, writes nothing); --confirm <token> applies it.
                                                  Adds new ids, skips identical, keeps yours on a clash. Copy/overwrite: Squads screen. Needs Drover mods with protocol 4
       drover config                              list the settings an agent may change on the owner's request, with the value in force (needs protocol 5)
       drover config max-parallel [<n>]           show / set drover-runs.max_parallel (1-10, squad runs active at once for each project; applies at once).
                                                  RAISE IT ONLY WHEN THE OWNER ASKS in plain text in your terminal, never to unblock yourself. The change is announced to the owner
       drover add "<title>" [--desc "<text>"] [--tag <t>]… [--column backlog|ready] [--priority P0-P3] [--project <id|name>] [--assignee <agent|squad>:<id>] [--parent <T-…>]   (--parent alone puts the card in the parent's project)
       drover move <T-…> <backlog|ready|in-progress|review|blocked|done>   (an agent cannot move to done: the owner does)
       drover next                                queue mode: free slots + Ready cards of your project (starts nothing)
       drover archive <T-…>                               archive a task (like the editor's Archive button)
       drover start <T-…|-> <squad|agent> [--worktree] [--project <id|name>]   open a squad (or 1 agent) on a task, or none (-);
                                                  its leader reports to you ($HC_TERMINAL_ID);
                                                  --project (agent drover only) binds that Drover to a project (queue mode)
       drover resume <R-…|T-…> [--recover|--cancel]   reopen a gone squad (leader + members) with their sessions: a run id, or a card id (its newest run);
                                                  needs a card that is not Done or archived and an ended run. --cancel stops an attempt in flight;
                                                  after a crash the card stays claimed until you run --recover (kills what the attempt owns, adopts or releases)
                                                  or --cancel (abandons it). Nothing recovers by itself
       drover asks-hook install|uninstall|status [--claude] [--codex] [--yes] [--claude-settings <file>] [--codex-hooks <file>]   opt-in: add (or remove) the asks hook in your Claude settings.json and Codex hooks.json; shows the exact diff and asks first, never overwrites, never automatic (see docs/mods/tasks.md)
       drover doctor [--home <dir>] [--claude-settings <file>] [--codex-hooks <file>]               read-only check of this install: mods linked, _lib copies, souls, stale loaded code hint, CLI on PATH, the asks hooks of Claude and Codex and their locks (one line each; exit 1 on a FAIL; fixes nothing)
       drover wake <terminal|T-…> <when> <message…>       once: now, 15m, 2h, 1d, 14:30, "tomorrow 9:00", "2026-11-12 09:00"
       drover wake <terminal|T-…> every <30m|2h|1d> <message…>   repeat (first time after one interval)
       drover wakes [terminal|T-…]                list wakeups (id, name, target, schedule, next, status, on/off)
       drover wake off|on <W-…>                   disable or enable one wakeup
       drover wake rm <W-…>                       remove one wakeup
EOF
  exit 2
}
json() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }
read_shared() { python3 - "$home/shared.json" "$@" <<'PY'
import json, sys
path, what, *args = sys.argv[1:]
try: d = json.load(open(path))
except FileNotFoundError: d = {}
all_tasks = d.get("drover.tasks", [])
tasks = [t for t in all_tasks if not t.get("archived")]
# Same names as the board (store.js COLUMNS: label lowercased, spaces -> hyphens). Stored ids (todo, doing) stay valid input; mods/_test/drover-cli-columns.test.js checks this table against store.js.
COLUMNS = [("backlog", "Backlog"), ("todo", "Ready"), ("doing", "In progress"), ("review", "Review"), ("blocked", "Blocked"), ("done", "Done")]
def cname(i): return next((l.lower().replace(" ", "-") for c, l in COLUMNS if c == i), i)
def squash(v): return "".join(ch for ch in str(v).lower() if ch not in " _-")
def cid(v): return next((c for c, l in COLUMNS if squash(v) and squash(v) in (squash(c), squash(l))), None)
projects = d.get("drover.projects") or []
def repo(p):
    r = p.get("repos") or []
    return next((x["path"] for x in r if x.get("default")), r[0]["path"] if r else "-")
def find(k):
    return next((p for p in projects if p["id"] == k or p["name"].lower() == k.lower()), None)
if what == "column":
    c = cid(args[0])
    if not c: sys.exit(f'error: unknown column {args[0]} (use {", ".join(cname(c) for c, _ in COLUMNS)})')
    print(c)
elif what == "projects":
    for p in projects: print(f'{p["id"]}  {p["name"]}  {repo(p)}')
    if not projects: print('no projects (create one: drover project add "<name>" --repo <abs path>)', file=sys.stderr)
elif what == "tasks":
    pf = None
    if "--project" in args:
        i = args.index("--project")
        if i + 1 >= len(args): sys.exit("error: --project needs an id or name")
        pf = find(args[i + 1])
        if not pf: sys.exit(f"error: no project {args[i + 1]} (see: drover projects)")
        args = args[:i] + args[i + 2:]
        tasks = [t for t in tasks if t.get("project") == pf["id"]]
    f = args[0].lower().lstrip("#") if args else None
    fc = cid(f) if f else None  # a column name, label or stored id; anything else is a tag
    order = {"doing": 0, "review": 1, "blocked": 2, "todo": 3, "backlog": 4, "done": 5}
    for t in sorted(tasks, key=lambda t: (order.get(t["column"], 9), t.get("priority", "P2"))):
        if f and f != t["column"] and fc != t["column"] and f not in t.get("tags", []): continue
        tags = " ".join("#" + x for x in t.get("tags", []))
        print(f'{t["id"]}  {cname(t["column"]):<11} {t.get("priority","P2")}  {t["title"]}{"  " + tags if tags else ""}{"  agent " + t["agent"] if t.get("agent") else ""}')
elif what == "task":
    t = next((t for t in tasks if t["id"] == args[0]), None)
    if not t: sys.exit(f"error: no task {args[0]}")
    print(f'{t["id"]} [{cname(t["column"])}] {t.get("priority","P2")} {t["title"]}')
    if t.get("tags"): print("tags: " + ", ".join(t["tags"]))
    pr = find(t["project"]) if t.get("project") else None
    if pr: print(f'project: {pr["name"]} ({pr["id"]}) repo {repo(pr)}')
    if t.get("parent"):  # an archived parent still shows; only a deleted one is not found
        pc = next((x for x in all_tasks if x["id"] == t["parent"]), None)
        print(f'parent: {t["parent"]} {pc["title"]}' if pc else f'parent: {t["parent"]} (not found)')
    a = t.get("assignee")
    if isinstance(a, dict) and a.get("kind") and a.get("id"): print(f'assignee: {a["kind"]}:{a["id"]}')
    if t.get("source"): print("source: " + t["source"].get("url", ""))
    if t.get("desc"): print("\n" + t["desc"])
    if t.get("notes"):
        import datetime
        print("\n## Notes")
        import re
        seen = set()
        def fnv(s):  # two FNV-1a 32-bit passes over the UTF-8 bytes: same as store.js noteIds
            out = ""
            for h in (0x811c9dc5, 0x9e3779b9):
                for c in s.encode(): h = ((h ^ c) * 16777619) & 0xffffffff
                out += "%08x" % h
            return out
        def nid(n):  # same ids as the editor's store.js (noteIds): kept when valid, else fnv(at\nby\ntext)
            if re.fullmatch(r"N-[0-9a-f]{6,}", str(n.get("id", ""))) and n["id"] not in seen: seen.add(n["id"]); return n["id"]
            h = fnv(f'{n.get("at")}\n{n.get("by", "")}\n{n.get("text", "")}'); k = 0
            while "N-" + h in seen: k += 1; h = fnv(f"{h}#{k}")
            seen.add("N-" + h); return "N-" + h
        for n in t["notes"]: print(f'- {t["id"]}#{nid(n)} · {datetime.datetime.fromtimestamp(n["at"] / 1000).strftime("%Y-%m-%d %H:%M")} · {n["by"]}{" · [" + n["kind"] + "]" if n.get("kind") else ""} · {n["text"]}')
elif what == "squads":
    cfg = d.get("drover.agents") or {}
    for q in cfg.get("squads", []):
        print(f'squad {q["id"]:<14} {q["name"]}: leader {q["leader"]}, members ' + (", ".join(m["agent"] for m in q.get("members", [])) or "none"))
    for a in cfg.get("agents", []):
        print(f'agent {a["id"]:<14} {a["name"]}: {a["command"]}')
    if not cfg: print("default squads: cattle-drive, stray, scouting, dev-review (open the Squads screen once to save them)")
PY
}
# write_polls: poll count for `move` and `add` (one poll = 0.25 s; the default is 5 s = 20 polls). DROVER_WRITE_WAIT exists for tests: a whole number of
# milliseconds in [0, 5000] (ceil(N/250) polls). Anything else (unset, empty, non-numeric, negative, decimal, above 5000, junk around the digits) keeps the default.
send_polls=""  # set per call (send_polls=N send ...) so the environment never leaks in
write_polls() {
  local v="${DROVER_WRITE_WAIT:-}"
  if [[ "$v" =~ ^[0-9]{1,4}$ ]] && [ $(( 10#$v )) -le 5000 ]; then echo $(( (10#$v + 249) / 250 )); else echo 20; fi
}
send() {  # body, seconds to wait for the answer, optional name suffix
  dir="$home/data/drover-inbox"; mkdir -p "$dir"
  name="$(date +%s)-$$${3:-}"
  printf '%s\n' "$1" > "$dir/.$name.tmp"
  mv "$dir/.$name.tmp" "$dir/$name.json"
  if [ -n "$send_polls" ]; then  # move/add only (write_polls): an exact count, 0 allowed, so no seq (BSD seq 0 counts down and would poll twice)
    for (( i = 0; i < send_polls; i++ )); do
      if [ -s "$dir/$name.result" ]; then  # non-empty: a consumer's writeFile creates the file empty first; an empty one is not an answer yet
        result="$(cat "$dir/$name.result")"; rm -f "$dir/$name.result"; echo "$result"
        [[ "$result" == ok:* ]]; exit
      fi
      sleep 0.25
    done
  else  # every other caller: the legacy loop, unchanged
    for _ in $(seq $(( $2 * 4 ))); do
      if [ -s "$dir/$name.result" ]; then  # non-empty: a consumer's writeFile creates the file empty first; an empty one is not an answer yet
        result="$(cat "$dir/$name.result")"; rm -f "$dir/$name.result"; echo "$result"
        [[ "$result" == ok:* ]]; exit
      fi
      sleep 0.25
    done
  fi
  echo "queued: no Drover Tasks, Board or Wakeups mod is open; it applies when one opens"
}
# Agents export/import: this script only carries text. Validation, the secret scan and the merge rules live in the consuming mod (JS).
# The probe first: a Drover without protocol 4 is refused cleanly (an old consumer would answer the new ops with "Unknown drover command").
# Returns 0 (protocol N+), 1 (too old, message printed) or 2 (no mod answered). protocol_need <N> <what> [cleanup]: with cleanup the unanswered probe file is removed (a probe left queued would answer later).
protocol_need() {
  r="$(send '{"op":"protocol","ttlMs":60000}' "${DROVER_CONFIG_WAIT:-${DROVER_AGENTS_WAIT:-5}}" -probe)" || true  # send() answers, cleans up its result and prints "queued:" when nobody answers
  case "$r" in queued:*) [ -z "${3:-}" ] || rm -f "$home/data/drover-inbox/"*-$$-probe.json; return 2 ;; esac
  if [[ "$r" =~ ^ok:\ protocol\ ([0-9]+)$ ]] && [ "${BASH_REMATCH[1]}" -ge "$1" ]; then return 0; fi
  echo "error: this machine's Drover mods are too old for $2 (answer: ${r%%$'\n'*}); update the mods (protocol $1 needed)" >&2
  return 1
}
protocol4() { protocol_need 4 "agents export/import"; }
# drover config: the consumer holds the allowlist and every check; this only carries text. The probe comes BEFORE the request, so with no consumer or an old one
# nothing is queued. A change to a global setting must never apply later by surprise: it carries a 60 s ttl, and an unanswered set is reported as unknown.
config() {
  [ $# -le 2 ] || usage
  case "${1:-}" in
    "") body='{"op":"config-get"}' ;;
    max-parallel)
      if [ $# -eq 1 ]; then body='{"op":"config-get","key":"drover-runs.max_parallel"}'
      else
        v="$2"; [ -n "$v" ] || usage
        if [[ "$v" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then vj="$v"; else vj="$(json "$v")"; fi  # a number goes as a number; anything else is sent as text and refused by the consumer
        body="{\"op\":\"config-set\",\"key\":\"drover-runs.max_parallel\",\"value\":$vj,\"from\":$(json "${HC_TERMINAL_ID:-}"),\"ttlMs\":60000}"
      fi ;;
    *) usage ;;
  esac
  rc=0; protocol_need 5 "drover config" cleanup || rc=$?
  if [ "$rc" -eq 2 ]; then echo "error: no Drover mod is open, nothing changed (open Drover, then run it again)" >&2; exit 1; fi
  [ "$rc" -eq 0 ] || exit 1
  rc=0; res="$(send "$body" "${DROVER_CONFIG_WAIT:-5}" -config)" || rc=$?
  case "$res" in queued:*) echo "error: no answer from Drover; the change is not confirmed (it may still apply; the request expires 60 s after it was sent). Check: drover config max-parallel" >&2; exit 1 ;; esac
  printf '%s\n' "$res"; exit "$rc"
}
agents_cmd() {  # the op as one JSON line, built in python from argv/file: the file never goes through a shell variable or argv
  python3 - "$@" <<'PY'
import json, sys, time
op, *a = sys.argv[1:]
if op == "import":
    path, token, nonce = a
    try: text = open(path, encoding="utf-8", errors="replace").read()
    except OSError as e: sys.exit(f"error: cannot read {path}: {e.strerror}")
    c = {"op": "agents-import", "file": text}
    if token: c.update(confirm=True, token=token, nonce=nonce, expiresAt=int(time.time() * 1000) + 3600000)  # an absolute expiry: the confirm is void 1 hour from now, queued or not
else:
    c = {"op": "agents-export"}
    for k, v in (("agents", a[0]), ("squads", a[1])):
        if v: c[k] = v.split("\n")
print(json.dumps(c))
PY
}
agents() {
  case "${1:-}" in
    import)
      [ $# -ge 2 ] || usage
      file="$2"; shift 2; token=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --confirm) [ $# -ge 2 ] && [[ "$2" =~ ^[0-9a-f]{64}$ ]] || usage; token="$2"; shift 2 ;;
          *) usage ;;
        esac
      done
      [ -f "$file" ] || { echo "error: no file $file" >&2; exit 1; }
      body="$(agents_cmd import "$file" "$token" "$(date +%s)-$$-$RANDOM$RANDOM")" || exit 1
      rc=0; protocol4 || rc=$?
      [ "$rc" -ne 1 ] || exit 1
      # rc 2: no mod answered. send() then leaves the request queued (a confirm is safe: a changed file or configuration makes it stale). It is NOT applied yet.
      send "$body" "${DROVER_AGENTS_WAIT:-10}" -import ;;
    export)
      shift; out="" ag="" sq=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --out) [ $# -ge 2 ] || usage; out="$2"; shift 2 ;;
          --agent) [ $# -ge 2 ] || usage; ag="${ag:+$ag$'\n'}$2"; shift 2 ;;
          --squad) [ $# -ge 2 ] || usage; sq="${sq:+$sq$'\n'}$2"; shift 2 ;;
          *) usage ;;
        esac
      done
      if [ -n "$out" ] && [ -e "$out" ]; then echo "error: $out exists; remove it or pick another name" >&2; exit 1; fi
      # Headless first: when node is installed, the read-only export script runs the same JS core on shared.json (no mod needed, no env file opened).
      # Otherwise the export goes through an open Drover mod (the inbox op). Either way the shell validates nothing.
      node_bin="${DROVER_NODE:-node}" # `here` (this script's physical folder, helpers and core next to it) is resolved once, at the top
      skipnote=""; res=""; nrc=9   # 9: node not used; 3: this node cannot load the core (use the inbox); else the script's own exit code
      if command -v "$node_bin" >/dev/null 2>&1 && [ -f "$here/drover-export.mjs" ] && [ -f "$here/../herd-export.js" ]; then
        nargs=(--home "$home")
        while IFS= read -r x; do [ -z "$x" ] || nargs+=(--agent "$x"); done <<<"$ag"
        while IFS= read -r x; do [ -z "$x" ] || nargs+=(--squad "$x"); done <<<"$sq"
        nrc=0; res="$("$node_bin" "$here/drover-export.mjs" "${nargs[@]}")" || nrc=$?
        if [ "$nrc" -ne 0 ] && [ "$nrc" -ne 3 ]; then printf '%s\n' "$res" >&2; exit 1; fi
        [ "$nrc" -ne 3 ] || skipnote="note: this node cannot load the export core; exported through an open Drover mod instead of the headless route"
      else
        skipnote="note: node not found ($node_bin) or the export helper is missing; exported through an open Drover mod instead of the headless route (put node on PATH or set DROVER_NODE)"
      fi
      if [ "$nrc" -ne 0 ]; then
        body="$(agents_cmd export "$ag" "$sq")" || exit 1
        rc=0; protocol4 || rc=$?
        if [ "$rc" -eq 2 ]; then echo "error: no node on this machine and no Drover Tasks, Board or Wakeups mod is open; an export needs one of them (nothing was exported)" >&2; exit 1; fi
        [ "$rc" -eq 0 ] || exit 1
        res="$(send "$body" "${DROVER_AGENTS_WAIT:-10}" -export)" || { printf '%s\n' "$res" >&2; exit 1; }
      fi
      case "$res" in ok:*) ;; *) printf '%s\n' "$res" >&2; exit 1 ;; esac
      printf '%s\n' "$res" | sed '/^---$/,$d' >&2   # header and warnings
      [ -z "$skipnote" ] || echo "$skipnote" >&2
      payload="$(printf '%s\n' "$res" | sed '1,/^---$/d')"
      if [ -n "$out" ]; then
        # Created exclusively with mode 0600 at the final write: an existing file or link (also one made while we waited) is never touched.
        printf '%s\n' "$payload" | python3 -c 'import os, sys
p = sys.argv[1]
try: fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
except OSError as e: sys.exit("error: cannot create " + p + ": " + e.strerror + " (an existing file or link is never overwritten)")
os.fchmod(fd, 0o600)
with os.fdopen(fd, "wb") as f: f.write(sys.stdin.buffer.read())' "$out" || exit 1
        echo "wrote $out" >&2
      else
        printf '%s\n' "$payload"
      fi ;;
    *) usage ;;
  esac
}
# drover doctor: a READ-ONLY report (no write, no exec of herdr/hc/gh, no network; works without Herdr). One line per check:
#   <ok|FAIL|WARN|skip>  <check>  <detail>      detail: at most 100 chars, fixed phrases, trusted names (mods, souls) and counts only.
# It never prints a path read from the disk, a file's content or an environment value. Exit 0 = no FAIL, 1 = a FAIL, 2 = usage.
# The repo is where this script really lives (mods/<mod>/bin/drover, symlinks followed), so it works from the linked home and from a test tree.
# The hash recipe is mods/install.sh's, byte for byte (mods/_test/drover-cli-doctor.test.js runs the real installer to guard drift).
doctor_ok=0; doctor_warn=0; doctor_fail=0
doctor_emit() {  # status check detail
  local d="${3//$'\n'/ }"
  case "$1" in ok) doctor_ok=$((doctor_ok + 1)) ;; WARN) doctor_warn=$((doctor_warn + 1)) ;; FAIL) doctor_fail=$((doctor_fail + 1)) ;; esac
  printf '%s  %s  %s\n' "$1" "$2" "${d:0:100}"
}
doctor_real() {  # the real path of a file: the symlink chain followed (readlink without -f: not portable to macOS)
  local s="$1" d
  while [ -L "$s" ]; do d="$(cd -P "$(dirname "$s")" && pwd)"; s="$(readlink "$s")"; case "$s" in /*) ;; *) s="$d/$s" ;; esac; done
  d="$(cd -P "$(dirname "$s")" && pwd)"; printf '%s/%s\n' "$d" "$(basename "$s")"
}
doctor_first() {  # "<first entry>[ (+N more)]" from a newline-separated list, whole entries only
  local first="${1%%$'\n'*}" n="$2"
  printf '%s' "$first"; [ "$n" -le 1 ] || printf ' (+%d more)' "$((n - 1))"
}
doctor() {
  local dhome="$home" me rm m t name total=0 nbad=0 bad="" anymiss=0 f cur manifest_ok=0
  local cfg_claude="${DROVER_CLAUDE_SETTINGS:-${HOME:-}/.claude/settings.json}" cfg_codex="${DROVER_CODEX_HOOKS:-${HOME:-}/.codex/hooks.json}" flag_claude="" flag_codex=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --home) [ $# -ge 2 ] || usage; dhome="$2"; shift 2 ;;
      --claude-settings) [ $# -ge 2 ] || usage; cfg_claude="$2"; flag_claude="$2"; shift 2 ;;
      --codex-hooks) [ $# -ge 2 ] || usage; cfg_codex="$2"; flag_codex="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  me="$(doctor_real "${BASH_SOURCE[0]}")"
  rm="$(cd -P "$(dirname "$me")/../.." && pwd)"   # the repo's mods/ folder
  # 1. mods-linked: every repo mod has a symlink in the home that resolves to it. DROVER_SKIP_MODS is install-time only: a missing link is a FAIL.
  for m in "$rm"/drover-*/; do
    m="${m%/}"; [ -d "$m" ] || continue; name="${m##*/}"; total=$((total + 1)); t="$dhome/mods/$name"
    if [ -L "$t" ]; then
      [ "$(cd -P "$t" 2>/dev/null && pwd)" = "$m" ] || { nbad=$((nbad + 1)); bad="$bad$name points elsewhere"$'\n'; }
    elif [ -e "$t" ]; then nbad=$((nbad + 1)); bad="$bad$name not a link"$'\n'
    else nbad=$((nbad + 1)); anymiss=1; bad="$bad$name missing"$'\n'; fi
  done
  if [ "$total" -eq 0 ]; then doctor_emit FAIL mods-linked "no drover mod found next to this script"
  elif [ "$nbad" -eq 0 ]; then doctor_emit ok mods-linked "$total mods linked to this repo"
  else
    # short and whole: the count, the first failure, then the hint (only a really missing mod mentions DROVER_SKIP_MODS)
    doctor_emit FAIL mods-linked "$nbad of $total mods: $(doctor_first "$bad" "$nbad"); run install.sh$([ "$anymiss" = 1 ] && printf ' (no DROVER_SKIP_MODS)')"
  fi
  # 2. lib-copies: each mod's copy of a shared _lib file is byte-equal to _lib's (list: _lib/copies.txt), and drover-config/query.js to drover-github/query.js.
  # A manifest that cannot be read is a FAIL (never a pass by an empty loop): every later read of it is gated on manifest_ok, so no shell diagnostic can print a path.
  [ -f "$rm/_lib/copies.txt" ] && [ -r "$rm/_lib/copies.txt" ] && manifest_ok=1
  if [ "$manifest_ok" != 1 ]; then doctor_emit FAIL lib-copies "_lib/copies.txt is missing or unreadable"
  else
    nbad=0; bad=""
    for m in "$rm"/drover-*/; do
      m="${m%/}"; [ -d "$m" ] || continue; name="${m##*/}"
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        cmp -s "$rm/_lib/$f" "$m/$f" 2>/dev/null || { nbad=$((nbad + 1)); bad="$bad$name/$f"$'\n'; }
      done < "$rm/_lib/copies.txt"
    done
    if [ -f "$rm/drover-github/query.js" ] && ! cmp -s "$rm/drover-github/query.js" "$rm/drover-config/query.js" 2>/dev/null; then nbad=$((nbad + 1)); bad="${bad}drover-config/query.js"$'\n'; fi
    if [ "$nbad" -eq 0 ]; then doctor_emit ok lib-copies "every shared copy equals _lib"
    else doctor_emit FAIL lib-copies "differs: $nbad files, first ${bad%%$'\n'*}; run install.sh"; fi
  fi
  # 3. souls: each soul the repo lists, and _herd.md, exists in the home and is not empty.
  nbad=0; bad=""; total=0
  for f in _herd.md $(cd "$rm/drover-agents/souls" 2>/dev/null && ls -- *.md 2>/dev/null | grep -v '^_herd\.md$' || true); do
    total=$((total + 1)); t="$dhome/mods/drover-agents/souls/$f"
    if [ ! -e "$t" ]; then nbad=$((nbad + 1)); bad="$bad$f missing"$'\n'
    elif [ ! -s "$t" ]; then nbad=$((nbad + 1)); bad="$bad$f empty"$'\n'; fi
  done
  if [ "$nbad" -eq 0 ]; then doctor_emit ok souls "$total souls present"
  else doctor_emit FAIL souls "$nbad of $total: $(doctor_first "$bad" "$nbad")"; fi
  # 4. lib-stamp: the fingerprint of the shared set vs the stamp install.sh wrote. A hint, never a FAIL: a running Herdr cannot be probed without a write.
  local hasher="" lib_hash="" stamp="$dhome/.drover-lib-stamp" have_links=0 l
  if command -v sha256sum >/dev/null 2>&1; then hasher="sha256sum"; elif command -v shasum >/dev/null 2>&1; then hasher="shasum -a 256"; elif command -v cksum >/dev/null 2>&1; then hasher="cksum"; fi
  if [ -n "$hasher" ] && [ "$manifest_ok" = 1 ]; then
    lib_hash="$( { while IFS= read -r f; do [ -n "$f" ] && cat "$rm/_lib/$f"; done < "$rm/_lib/copies.txt"; [ ! -f "$rm/drover-github/query.js" ] || cat "$rm/drover-github/query.js"; } 2>/dev/null | $hasher 2>/dev/null )" || lib_hash=""
    ( while IFS= read -r f; do [ -z "$f" ] || [ -f "$rm/_lib/$f" ] || exit 1; done < "$rm/_lib/copies.txt" ) || lib_hash=""   # a subshell: the exit must not end doctor
  fi
  for l in "$dhome"/mods/drover-*; do [ -L "$l" ] && have_links=1; done
  if [ -z "$hasher" ]; then doctor_emit skip lib-stamp "cannot fingerprint: no sha256sum, shasum or cksum"
  elif [ -z "$lib_hash" ]; then doctor_emit skip lib-stamp "cannot fingerprint: a shared _lib file is missing or unreadable"
  elif [ -f "$stamp" ]; then
    if [ "$(cat "$stamp" 2>/dev/null)" = "$lib_hash" ]; then doctor_emit ok lib-stamp "same as the last install (a running Herdr is not probed)"
    else doctor_emit WARN lib-stamp "_lib changed since install; Herdr may hold old code (not probed): reopen the window"; fi
  elif [ "$have_links" = 1 ]; then doctor_emit WARN lib-stamp "no install stamp; Herdr may hold old code (not probed): reopen the window"
  else doctor_emit skip lib-stamp "no install stamp yet"; fi
  # 5. cli-path: `drover` on PATH is this very file (an agent may call it by full path, so only a WARN).
  cur="$(command -v drover 2>/dev/null)" || cur=""
  if [ -z "$cur" ] || [ ! -f "$cur" ]; then doctor_emit WARN cli-path "not on PATH (agents can still call it by full path)"
  elif [ "$(doctor_real "$cur")" = "$me" ]; then doctor_emit ok cli-path "on PATH"
  else doctor_emit WARN cli-path "PATH copy is another file"; fi
  # 6. accept-locks (B3b): an Accept chain holds a lock directory while it runs and removes it when it ends. One older than 15 minutes means an Accept
  # stopped without finishing. Read-only: counts only, never a key or a path, never a removal (clearing one is the owner's call, see docs/mods/tasks.md).
  local adir="$dhome/data/drover-accept" nold=0 ld at tnow
  tnow="$(date +%s 2>/dev/null)" || tnow=""
  if [ -d "$adir" ]; then
    for ld in "$adir"/*.lock; do
      [ -d "$ld" ] || continue
      at="$(sed -n 2p "$ld/token" 2>/dev/null)" || at=""
      case "$at" in ''|*[!0-9]*|????????????????*) nold=$((nold + 1)); continue ;; esac   # no readable start time: treated as old
      if [ -z "$tnow" ] || [ $((tnow - at)) -gt 900 ]; then nold=$((nold + 1)); fi
    done
  fi
  if [ "$nold" -eq 0 ]; then doctor_emit ok accept-locks "no accept lock older than 15 min"
  else doctor_emit WARN accept-locks "$nold accept lock$([ "$nold" -eq 1 ] || printf s) older than 15 min (a stopped Accept?); see docs/mods/tasks.md"; fi
  # 7. hooks: the asks hook of each agent CLI (B4a). Read-only: a node helper reads the one config file and answers a fixed code; no path, value or content is ever printed.
  # Absent file or no Drover hook = skip (the install is opt-in); a hook that is incomplete, unknown or points nowhere = WARN, never FAIL.
  local node_bin="" kind file code
  node_bin="$(command -v "${DROVER_NODE:-node}" 2>/dev/null)" || node_bin=""
  local installed=0 rcode
  # one resolver for install, uninstall, status and doctor: flag, then DROVER_*, then CLAUDE_CONFIG_DIR / CODEX_HOME, then $HOME (drover-asks-install.mjs)
  if [ -n "$node_bin" ]; then
    rcode="$("$node_bin" "$here/drover-asks-install.mjs" resolve claude ${flag_claude:+--claude-settings "$flag_claude"} 2>/dev/null </dev/null | head -n 1)" && [ -n "$rcode" ] && cfg_claude="$rcode"
    rcode="$("$node_bin" "$here/drover-asks-install.mjs" resolve codex ${flag_codex:+--codex-hooks "$flag_codex"} 2>/dev/null </dev/null | head -n 1)" && [ -n "$rcode" ] && cfg_codex="$rcode"
  fi
  for kind in claude codex; do
    if [ "$kind" = claude ]; then file="$cfg_claude"; else file="$cfg_codex"; fi
    if [ -z "$node_bin" ]; then doctor_emit skip "hooks-$kind" "cannot read JSON (no node)"; continue; fi
    code="$("$node_bin" "$here/drover-asks-check.mjs" "$kind" "$file" 2>/dev/null </dev/null | head -n 1)" || code=""
    case "$code" in ok:[0-9]*|unknown|missing|noscript|noexec|action|command) installed=1 ;; esac
    case "$code" in
      ok:[0-9]*) doctor_emit ok "hooks-$kind" "${code#ok:} events call an existing script" ;;
      absent) doctor_emit skip "hooks-$kind" "no config file (not installed)" ;;
      none) doctor_emit skip "hooks-$kind" "not installed (opt-in)" ;;
      unreadable) doctor_emit WARN "hooks-$kind" "config unreadable" ;;
      unknown) doctor_emit WARN "hooks-$kind" "an event is unknown to this Drover" ;;
      missing) doctor_emit WARN "hooks-$kind" "an event of the set is missing" ;;
      noscript) doctor_emit WARN "hooks-$kind" "hook script missing" ;;
      noexec) doctor_emit WARN "hooks-$kind" "hook script not executable" ;;
      action) doctor_emit WARN "hooks-$kind" "an event has the wrong action" ;;
      command) doctor_emit WARN "hooks-$kind" "hook command not recognised" ;;
      *) doctor_emit WARN "hooks-$kind" "check could not run" ;;
    esac
  done
  # 7b. hooks-runtime: a registered hook needs node. The launcher uses node on the hook's PATH, else the absolute path in <home>/data/drover-asks-runtime (install writes it; uninstall never removes it).
  if [ -z "$node_bin" ]; then doctor_emit skip hooks-runtime "cannot read the runtime file (no node)"
  elif [ "$installed" = 0 ]; then doctor_emit skip hooks-runtime "no hook installed"
  else
    code="$("$node_bin" "$here/drover-asks-check.mjs" runtime "$dhome/data/drover-asks-runtime" 2>/dev/null </dev/null | head -n 1)" || code=""
    if [ -n "$(command -v node 2>/dev/null)" ]; then doctor_emit ok hooks-runtime "node is on PATH"
    else
      case "$code" in
        present) doctor_emit ok hooks-runtime "no node on PATH; the runtime file names an existing node" ;;
        absent) doctor_emit WARN hooks-runtime "no node on PATH and no runtime file: the hooks do nothing (run drover asks-hook install again)" ;;
        differs) doctor_emit WARN hooks-runtime "no node on PATH and the runtime file does not name an existing node: the hooks do nothing" ;;
        *) doctor_emit WARN hooks-runtime "check could not run" ;;
      esac
    fi
  fi
  # 8. hooks-locks: a <t>.lock folder of the asks hook older than 10 s (LOCK_STALE_MS) = a hook stopped mid-write; the next hook reclaims it by age. Fixed text only.
  if [ -z "$node_bin" ]; then doctor_emit skip hooks-locks "cannot read the folder (no node)"
  else
    code="$("$node_bin" "$here/drover-asks-check.mjs" locks "$dhome/data/drover-asks" 2>/dev/null </dev/null | head -n 1)" || code=""
    case "$code" in
      nodir) doctor_emit skip hooks-locks "no asks folder yet" ;;
      ok) doctor_emit ok hooks-locks "no stale lock" ;;
      stale) doctor_emit WARN hooks-locks "a lock is older than 10 s (a hook stopped mid-write; the next hook clears it)" ;;
      *) doctor_emit WARN hooks-locks "check could not run" ;;
    esac
  fi
  printf 'doctor: %d ok, %d warn, %d fail\n' "$doctor_ok" "$doctor_warn" "$doctor_fail"
  [ "$doctor_fail" -eq 0 ]
}
case "${1:-}" in
  agents) agents "${@:2}" ;;
  config) config "${@:2}" ;;
  doctor) doctor "${@:2}" ;;
  asks-hook) exec "${DROVER_NODE:-node}" "$here/drover-asks-install.mjs" "${@:2}" ;;
  machines) exec "${DROVER_NODE:-node}" "$here/drover-machines.mjs" "${@:2}" ;;
  tasks) read_shared tasks "${@:2}" ;;
  task) [ $# -eq 2 ] || usage; read_shared task "$2" ;;
  squads) read_shared squads ;;
  projects) read_shared projects ;;
  note)
    [ $# -ge 3 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    id="$2"; shift 2; kind=""
    if [ "${1:-}" = "--kind" ]; then [ $# -ge 3 ] || usage; kind="$2"; shift 2; fi
    send "{\"op\":\"note\",\"id\":\"$id\",\"text\":$(json "$*"),\"kind\":$(json "$kind"),\"by\":$(json "${HC_TERMINAL_ID:-}")}" 5 ;;
  line)
    [ $# -ge 3 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    id="$2"; shift 2; words=(); progress=""; have_progress=0 # supplied is not the same as non-empty: --progress "" must be refused, not dropped
    while [ $# -gt 0 ]; do
      if [ "$1" = "--progress" ]; then [ $# -ge 2 ] || usage; progress="$2"; have_progress=1; shift 2; else words+=("$1"); shift; fi
    done
    [ ${#words[@]} -gt 0 ] || usage
    # The same checks as the consumer, BEFORE anything is written: a refused text (a secret, a home path) never lands in the inbox directory.
    if [ "$have_progress" = 1 ]; then pargs=("$progress"); else pargs=(); fi  # the helper gets a progress argument only when the flag was supplied (even empty)
    norm="$("${DROVER_NODE:-node}" "$here/drover-line.mjs" "${words[*]}" ${pargs[@]+"${pargs[@]}"})" || { echo "error: the line was not sent (checked before sending; node is needed for the check)" >&2; exit 2; }
    text="${norm%%$'\n'*}"; progress=""; [[ "$norm" == *$'\n'* ]] && progress="${norm#*$'\n'}"  # the helper's normalised values go on the wire, never the raw argv
    if [ -n "$progress" ]; then pj=",\"progress\":$progress"; else pj=""; fi
    send "{\"op\":\"line\",\"id\":\"$id\",\"text\":$(json "$text")$pj,\"by\":$(json "${HC_TERMINAL_ID:-}"),\"ttlMs\":300000}" 5 ;;  # a line queued while no mod is open must not apply late as if fresh
  edit)
    [ $# -ge 4 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    id="$2"; shift 2; fields=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) [ $# -ge 2 ] || usage; fields="$fields,\"title\":$(json "$2")"; shift 2 ;;
        --desc) [ $# -ge 2 ] || usage; fields="$fields,\"desc\":$(json "$2")"; shift 2 ;;
        --parent) [ $# -ge 2 ] && { [ "$2" = none ] || [[ "$2" =~ ^T-[A-Z0-9]+$ ]]; } || usage; fields="$fields,\"parent\":$(json "$2")"; shift 2 ;;
        *) usage ;;
      esac
    done
    send "{\"op\":\"edit\",\"id\":\"$id\"$fields}" 5 ;;
  project)
    [ "${2:-}" = add ] && [ $# -ge 3 ] || usage
    pname="$3"; shift 3; repo="" branch="" folders=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2 ;;
        --branch) [ $# -ge 2 ] || usage; branch="$2"; shift 2 ;;
        --folder) [ $# -ge 2 ] || usage; folders+=("$2"); shift 2 ;;
        *) usage ;;
      esac
    done
    [[ "$repo" == /* ]] || usage
    fj="[$(for f in ${folders[@]+"${folders[@]}"}; do printf '%s,' "$(json "$f")"; done | sed 's/,$//')]"
    if [ -n "$branch" ]; then bj=",\"branch\":$(json "$branch")"; else bj=""; fi
    send "{\"op\":\"project-add\",\"name\":$(json "$pname"),\"repo\":$(json "$repo")$bj,\"folders\":$fj}" 30 ;;
  task-project)
    [ $# -eq 3 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    send "{\"op\":\"project\",\"id\":\"$2\",\"project\":$(json "$3")}" 5 ;;
  link)
    [ $# -eq 3 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    send "{\"op\":\"link\",\"id\":\"$2\",\"url\":$(json "$3"),\"by\":$(json "${HC_TERMINAL_ID:-}")}" 5 ;;
  move)
    [ $# -eq 3 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    col="$(read_shared column "$3")" || exit 2  # a name or a stored id in, the stored id on the wire
    send_polls="$(write_polls)" send "{\"op\":\"move\",\"id\":\"$2\",\"column\":\"$col\",\"from\":$(json "${HC_TERMINAL_ID:-}")}" 5 ;;
  next)
    [ $# -eq 1 ] || usage
    send "{\"op\":\"next\",\"from\":$(json "${HC_TERMINAL_ID:-}")}" 5 ;;
  archive)
    [ $# -eq 2 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage
    send "{\"op\":\"archive\",\"id\":\"$2\"}" 5 ;;
  add)
    [ $# -ge 2 ] || usage
    title="$2"; shift 2; desc="" column="backlog" priority="P2" project="" assignee="" parent="" tags=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --desc) desc="$2"; shift 2 ;; --tag) tags+=("$2"); shift 2 ;;
        --column) column="$2"; shift 2 ;; --priority) priority="$2"; shift 2 ;;
        --project) project="$2"; shift 2 ;; --assignee) assignee="$2"; shift 2 ;;
        --parent) [ $# -ge 2 ] && [[ "$2" =~ ^T-[A-Z0-9]+$ ]] || usage; parent="$2"; shift 2 ;; *) usage ;;
      esac
    done
    column="$(read_shared column "$column")" || exit 2
    tj="[$(for t in ${tags[@]+"${tags[@]}"}; do printf '%s,' "$(json "$t")"; done | sed 's/,$//')]"
    aj=null
    if [ -n "$assignee" ]; then
      case "$assignee" in agent:?*|squad:?*) aj="{\"kind\":$(json "${assignee%%:*}"),\"id\":$(json "${assignee#*:}")}" ;; *) usage ;; esac
    fi
    send_polls="$(write_polls)" send "{\"op\":\"add\",\"title\":$(json "$title"),\"desc\":$(json "$desc"),\"tags\":$tj,\"column\":$(json "$column"),\"priority\":$(json "$priority"),\"project\":$(json "$project"),\"assignee\":$aj,\"parent\":$(json "$parent")}" 5 ;;
  start)
    [ $# -ge 3 ] || usage
    task="$2"; [ "$task" = "-" ] && task=""
    [ -z "$task" ] || [[ "$task" =~ ^T-[A-Z0-9]+$ ]] || usage
    runner="$3"; shift 3; wt=false; project=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --worktree) wt=true; shift ;;
        --project) [ $# -ge 2 ] || usage; project="$2"; shift 2 ;;
        *) usage ;;
      esac
    done
    send "{\"op\":\"start\",\"task\":$(json "$task"),\"runner\":$(json "$runner"),\"worktree\":$wt,\"project\":$(json "$project"),\"from\":$(json "${HC_TERMINAL_ID:-}")}" 120 ;;
  resume)
    shift; cancel=false; recover=false; ref=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --cancel) cancel=true; shift ;;
        --recover) recover=true; shift ;;
        *) [ -z "$ref" ] && [[ "$1" =~ ^[RT]-[A-Z0-9]+$ ]] || usage; ref="$1"; shift ;;
      esac
    done
    [ -n "$ref" ] || usage
    [ "$cancel" = true ] && [ "$recover" = true ] && usage
    send "{\"op\":\"resume\",\"ref\":$(json "$ref"),\"cancel\":$cancel,\"recover\":$recover}" "${DROVER_RESUME_WAIT:-120}" ;;
  wakes)
    [ $# -le 2 ] || usage
    send "{\"op\":\"wakes\",\"target\":$(json "${2:-}")}" 5 ;;
  wake)
    case "${2:-}" in off|on|rm)
      [ $# -eq 3 ] || usage
      send "{\"op\":\"wake-$2\",\"id\":$(json "$3")}" 5; exit ;;
    esac
    [ $# -ge 4 ] || usage
    target="$2"
    if [ "$3" = "every" ]; then
      [ $# -ge 5 ] || usage
      every="$4"; shift 4
      send "{\"op\":\"wake\",\"target\":$(json "$target"),\"every\":$(json "$every"),\"text\":$(json "$*")}" 5
    else
      when="$3"; shift 3
      send "{\"op\":\"wake\",\"target\":$(json "$target"),\"when\":$(json "$when"),\"text\":$(json "$*")}" 5
    fi ;;
  *) usage ;;
esac
