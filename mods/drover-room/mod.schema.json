{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Room mod.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ]
    },
    "size": {
      "type": "number",
      "minimum": 0
    },
    "focusable": {
      "type": "boolean"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refresh_minutes": {
          "title": "Refresh every",
          "description": "How old a run's issue and PR data gets before the Room reloads it. Takes effect when the Room reopens.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "x-unit": "min",
          "default": 5
        }
      }
    }
  }
}
